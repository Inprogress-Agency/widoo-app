{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node scripts (sync, generate): TypeScript 6 includes no @types package by default.
    "types": ["node"]
  },
  "include": ["src", "generated"],
  // The icon map imports the TSX sources of Phosphor, typed with the NativeWind props of the app:
  // the mobile typecheck covers it, where it is imported.
  "exclude": ["generated/icons.ts"]
}
