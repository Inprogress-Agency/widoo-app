# Admin web (apps/admin). Copy to .env.local for development. The values are written in the pages
# at build time: staging and production each build their own image. Nothing here is a secret:
# every NEXT_PUBLIC_ value is sent to the browser.

# Origin of the API, without path or trailing slash. The API must list the origin of the admin in
# its CORS_ORIGINS (http://localhost:5173 locally).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Web configuration of the Firebase project (Firebase console › Project settings › Your apps).
# These identify the project and are not secrets; staging and production each have their own.
# The values below only exist in the local Auth emulator.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-widoo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-widoo

# Local Auth emulator (`firebase emulators:start --only auth --project demo-widoo`), the same as
# FIREBASE_AUTH_EMULATOR_HOST of the API. Accepted with a demo-* project only; empty on staging
# and production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Dashboards the admin links to from its home page (A-05), https: the exact page of the Widoo
# project. Empty: the home page of PostHog Cloud EU and of RevenueCat.
NEXT_PUBLIC_POSTHOG_URL=
NEXT_PUBLIC_REVENUECAT_URL=
