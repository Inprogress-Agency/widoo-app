# Site web (apps/web). Copy to .env.local for development. The pages are built with these
# values: staging and production each build their own image.

# Canonical origin of the site, without trailing slash. Never written in the code (#233).
SITE_URL=http://localhost:3000

# Hosts redirected to SITE_URL with a 308, comma separated: www and the former domain.
SITE_ALIAS_HOSTS=

# true in production only: staging and previews answer noindex and close robots.txt.
SITE_INDEXABLE=false

# Store pages of the app, https; empty until the app is published.
APP_STORE_URL=
PLAY_STORE_URL=

# Origin of the Widoo API, called by the server only. Empty in development: the demo routes
# /r/demo-public, /r/demo-private and /r/demo-removed answer instead.
WIDOO_API_URL=
