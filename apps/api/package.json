{
  "name": "@widoo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "bench:search": "tsx --env-file-if-exists=.env src/search/bench.ts",
    "db:generate": "tsx src/db/generate.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts",
    "db:seed:recette": "tsx --env-file-if-exists=.env src/db/recette-seed-cli.ts",
    "legal:copies": "tsx src/legal/copies-cli.ts && prettier --write ../mobile/src/legal/generated",
    "fixtures:route-sheets": "tsx src/db/route-sheets-cli.ts && prettier --write ../mobile/src/route/generated/route-sheets.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "lint": "eslint .",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "transit:import": "tsx src/transit/import-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@sentry/node": "^10.75.2",
    "@widoo/orchestration": "workspace:*",
    "@widoo/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.5.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
