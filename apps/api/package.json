{
  "name": "@widoo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "db:migrate": "echo \"No migrations yet\"",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "lint": "eslint .",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@widoo/shared": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
