# Local values matching docker-compose.yml. Real secrets live in Secret Manager, never here.
# The API validates its variables at startup (src/config.ts) and refuses to start otherwise.
DATABASE_URL=postgres://widoo:widoo@localhost:5432/widoo

# development (default) | test | production. /docs is served outside production only.
NODE_ENV=development
# 127.0.0.1 by default; the Docker image listens on 0.0.0.0.
HOST=127.0.0.1
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Oldest app build still served (major.minor.patch), returned by GET /v1/config.
MIN_APP_VERSION=0.0.0
