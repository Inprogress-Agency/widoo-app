# Local values matching docker-compose.yml. Real secrets live in Secret Manager, never here.
# The API validates its variables at startup (src/config.ts) and refuses to start otherwise.
DATABASE_URL=postgres://widoo:widoo@localhost:5432/widoo

# development (default) | test | production. /docs is served outside production only.
NODE_ENV=development
# 127.0.0.1 by default; the Docker image listens on 0.0.0.0.
HOST=127.0.0.1
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Oldest app build still served (major.minor.patch), returned by GET /v1/config.
MIN_APP_VERSION=0.0.0
# Comma-separated browser origins allowed by CORS (the admin); empty refuses all. The app needs none.
CORS_ORIGINS=http://localhost:5173
# Proxies trusted for X-Forwarded-For (client IP of the rate limit): IP, CIDR, or loopback,
# linklocal, uniquelocal. Empty locally; to be set for Cloud Run at deployment.
TRUST_PROXY=
# Requests per minute and per client IP, all routes together.
RATE_LIMIT_MAX=1000
