# Local values matching docker-compose.yml. Real secrets live in Secret Manager, never here.
# The API validates its variables at startup (src/config.ts) and refuses to start otherwise.
DATABASE_URL=postgres://widoo:widoo@localhost:5432/widoo

# development (default) | test | production. /docs is served outside production only.
NODE_ENV=development
# 127.0.0.1 by default; the Docker image listens on 0.0.0.0.
HOST=127.0.0.1
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Oldest app build still served (major.minor.patch), returned by GET /v1/config.
MIN_APP_VERSION=0.0.0
# Comma-separated browser origins allowed by CORS (the admin); empty refuses all. The app needs none.
CORS_ORIGINS=http://localhost:5173
# Proxies trusted for X-Forwarded-For (client IP of the rate limit): IP, CIDR, or loopback,
# linklocal, uniquelocal. Empty locally; to be set for Cloud Run at deployment.
TRUST_PROXY=
# Requests per minute and per client IP, all routes together.
RATE_LIMIT_MAX=1000
# Firebase project whose ID tokens the API accepts; staging and production each have their own.
# No key file: firebase-admin uses Application Default Credentials (the Cloud Run service
# account). A demo-* project only exists in the Auth emulator and is refused in production.
FIREBASE_PROJECT_ID=demo-widoo
# Local Auth emulator (`firebase emulators:start --only auth`). Refused in production: the
# emulator accepts unsigned tokens.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Sentry project of the API (EU region). Empty: no error report. On Cloud Run, from Secret Manager.
SENTRY_DSN=
# Environment of the reports: staging or production on Cloud Run. Empty: NODE_ENV.
SENTRY_ENVIRONMENT=
# Service token of the scheduled jobs (/v1/internal/*, Cloud Scheduler), sent as
# `Authorization: Bearer <token>`: 32 to 256 letters, digits, - or _ (`openssl rand -hex 32`).
# Empty: the internal routes answer 404. On Cloud Run, from Secret Manager.
INTERNAL_TOKEN=
# Server token of Mapbox for the geocoding of the search (GET /v1/geocode), restricted to the
# geocoding and Search Box scopes; never the public token of the app. Empty: outside production,
# a short local list of Paris zones answers; in production, no zone. On Cloud Run, from Secret
# Manager.
MAPBOX_GEOCODING_TOKEN=
# true: permanent geocoding results (billed apart by Mapbox), which the API may keep 24 hours.
# false (default): temporary results, which Mapbox's terms forbid caching, so no cache.
MAPBOX_GEOCODING_PERMANENT=false
