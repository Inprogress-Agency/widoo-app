{
  "expo": {
    "name": "Widoo",
    "slug": "widoo",
    "owner": "inprogress-agency-team",
    "version": "0.1.0",
    "scheme": "widoo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "app.widoo",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "MGLMapboxMetricsEnabled": false
      }
    },
    "android": {
      "package": "app.widoo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#5A7FCF"
      }
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5A7FCF",
          "ios": {
            "image": "./assets/splash.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "backgroundColor": "#5A7FCF",
            "dark": { "image": "./assets/splash.png", "backgroundColor": "#5A7FCF" }
          },
          "android": {
            "image": "./assets/splash-android.png",
            "imageWidth": 288,
            "backgroundColor": "#4E74C8",
            "dark": { "image": "./assets/splash-android.png", "backgroundColor": "#4E74C8" }
          }
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Widoo utilise votre position pour centrer la carte sur les parcours autour de vous. Elle reste sur votre téléphone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "7af53d20-0e86-417b-b145-540c78800c80"
      }
    }
  }
}
