# Copy to .env.local (never versioned). Builds read these variables from their EAS environment.

# Empty in development: the app calls the API on the machine that serves Metro, port 8080.
EXPO_PUBLIC_API_URL=
# Project API key of PostHog Cloud EU (phc_…): public, write-only. Empty: no analytics at all.
EXPO_PUBLIC_POSTHOG_KEY=
