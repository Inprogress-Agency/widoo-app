# Copy to .env.local (never versioned). Builds read these variables from their EAS environment,
# names and roles in the README (App mobile › Builds EAS); a development build reads this file.

# Empty in development: the app calls the API on the machine that serves Metro, port 8080.
EXPO_PUBLIC_API_URL=
# Project API key of PostHog Cloud EU (phc_…). Leave empty in local development: the app ignores
# it there anyway. Builds get it from the EAS environment of their profile: `preview` → project
# « Widoo - Staging », `production` → the production project, once created; none in `development`.
EXPO_PUBLIC_POSTHOG_KEY=
# 1 in development: each event accepted after consent is written to the Metro log, never sent.
EXPO_PUBLIC_ANALYTICS_DEBUG=
# DSN of the Sentry project (EU region). Empty: no crash report.
EXPO_PUBLIC_SENTRY_DSN=
# Environment of crash reports and analytics; builds get it from eas.json. Empty: development,
# where no analytics event leaves the device.
EXPO_PUBLIC_APP_ENV=
# Public Mapbox token (pk.…), public scopes only: it ships inside the app.
EXPO_PUBLIC_MAPBOX_TOKEN=
