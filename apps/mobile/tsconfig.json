{
  // Expo's options (JSX, `react-native` export condition, DOM globals as React Native provides
  // them), then the strict options shared by the monorepo.
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["expo/types"]
  },
  "include": ["app", "src", "nativewind-env.d.ts"]
}
